# ---------------------------------------------------------------------------
# Steadfast: Vorlage fuer die Anwendungs-Konfiguration.
#
# Kopieren nach apps.toml (oder einem beliebigen Namen, als erstes
# Positionsargument uebergeben) und die Werte an die eigene App anpassen.
#
# Secrets gehoeren NICHT in die Datei: `${ENV_VAR}`-Indirection liest den
# Wert beim Start aus der Umgebungsvariable (Fail-Fast, wenn die Variable
# fehlt oder leer ist; Mindestlaengen gelten nach der Aufloesung):
#   Windows:  set MUSTER_JWT_SECRET=...     & set MUSTER_ADMIN_PASSWORD=...
#   Linux:    export MUSTER_JWT_SECRET=... ; export MUSTER_ADMIN_PASSWORD=...
# ---------------------------------------------------------------------------

[apps.muster_app]
# API-Key fuer Maschinen-zu-Maschinen-Zugriff (Endpunkte mit
# auth_mode = "api_key"); min. 16 Zeichen.
api_key_secret = "${MUSTER_APP_SECRET}"

  # --- Benutzer-Auth (JWT + Refresh-Rotation) -------------------------------
  # Aktiviert /{app}/_auth/* (login/register/refresh/logout/me/users) und
  # erlaubt auth_mode = "jwt" auf Endpunkten. Ohne [auth]-Sektion oder mit
  # enabled = false bleibt die App beim API-Key-/Gateway-Modell.
  [apps.muster_app.auth]
  enabled = true
  jwt_secret = "${MUSTER_JWT_SECRET}"        # min. 32 Zeichen
  access_token_secs = 900                    # Default 15 min
  refresh_token_secs = 2592000               # Default 30 Tage
  registration_open = false                  # Default: Admins legen User an
  # Origins fuer den Cookie-Modus (CSRF-Origin-Check, kein "*"); weglassen
  # = nur Bearer-Header-Modus:
  # allowed_origins = ["https://app.example.com"]

  # Bootstrap-Admin: wird beim Start angelegt, falls die E-Mail fehlt.
  admin_email = "admin@example.com"
  admin_password = "${MUSTER_ADMIN_PASSWORD}"

    # Passwort-Policy: jede Regel einzeln schaltbar (Defaults links).
    [apps.muster_app.auth.password_policy]
    min_length = 10          # 1..=1024
    max_length = 128         # <= 1024 (Argon2-DoS-Deckel), >= min_length
    require_lowercase = true
    require_uppercase = true
    require_digits = true
    require_special = true   # mind. ein Zeichen, das kein Buchstabe/Ziffer ist

    # Rate-Limiting der Auth-Endpunkte je Client-IP (Token-Bucket).
    [apps.muster_app.auth.rate_limit]
    login_per_min = 10
    register_per_min = 5
    refresh_per_min = 30

  # --- CORS (optional) ------------------------------------------------------
  # Ohne [cors]-Sektion schickt die Engine keine Access-Control-*Header —
  # Browser-Frontends sehen dann CORS-Fehler.
  [apps.muster_app.cors]
  allowed_origins = ["http://localhost:3000", "https://muster.example.com"]
  # Defaults, falls weggelassen:
  #   allowed_methods  = alle unterstuetzten (GET, POST, PUT, PATCH, DELETE)
  #   allowed_headers  = ["authorization", "content-type", "x-api-key",
  #                       "x-user-id", "x-user-role"]
  #   exposed_headers  = ["location"]
  #   allow_credentials = false
  #   max_age_secs     = kein Access-Control-Max-Age-Header
  allow_credentials = true   # noetig, wenn Browser den Refresh-Cookie nutzen

  # --- Endpunkte ------------------------------------------------------------
  # auth_mode: "api_key" (klassisch; kurz auch auth_required = true) oder
  # "jwt" (Bearer-Access-Token, optional mit Rollen-Allowlist). Kein
  # auth_mode = oeffentlicher Endpunkt.

  [apps.muster_app.endpoints.notes_get]
  path = "/notes"
  method = "GET"
  paging_default = 20
  filter_fields = ["status"]

  [apps.muster_app.endpoints.notes_create]
  path = "/notes"
  method = "POST"
  auth_mode = "jwt"
  roles = ["user", "admin"]

  business_logic = """
  fn on_request(payload, user) {
      if payload.title.len() == 0 {
          throw "Titel darf nicht leer sein.";
      }
      payload.created_by = user.id;
      payload.status = "offen";
      return payload;
  }
  """

    # --- Schema-Validierung (optional, nur POST/PUT/PATCH) -----------------
    # Wird beim Start vorkompiliert und VOR dem Skript geprueft: fehlende
    # Pflichtfelder oder Typverstoesse kommen als 400 mit
    # `error.code = "validation_failed"` zurueck, bevor Daten entstehen.
    #   required             — Pflichtfelder (bei PATCH ohne Pflicht-Check)
    #   allow_unknown_fields — false (Default) = strikt, undeklarierte Felder abweisen
    #   types                — Typ pro Feld: "string" | "number" | "boolean" |
    #                          "object" | "array" | "null" |
    #                          "date" (YYYY-MM-DD, inkl. Schaltjahre) |
    #                          "datetime" (RFC 3339, Offset/Z ist Pflicht)
    # Hinweis: der Schema-Block steht bewusst NACH business_logic — alles nach
    # einer [section] gehoert dieser Sektion.
    [apps.muster_app.endpoints.notes_create.schema]
    required = ["title"]
    allow_unknown_fields = true

      [apps.muster_app.endpoints.notes_create.schema.types]
      title = "string"

  [apps.muster_app.endpoints.notes_replace]
  path = "/notes"
  method = "PUT"
  auth_mode = "jwt"

  [apps.muster_app.endpoints.notes_patch]
  path = "/notes"
  method = "PATCH"
  auth_mode = "jwt"

  [apps.muster_app.endpoints.notes_delete]
  path = "/notes"
  method = "DELETE"
  auth_mode = "jwt"
  roles = ["admin"]

  # Rollenbeschraenkter Endpunkt: nur Admins.
  [apps.muster_app.endpoints.audit_get]
  path = "/audit"
  method = "GET"
  auth_mode = "jwt"
  roles = ["admin"]

  # Maschinen-Endpunkt: klassischer API-Key, parallel zur Benutzer-Auth.
  [apps.muster_app.endpoints.imports_post]
  path = "/imports"
  method = "POST"
  auth_mode = "api_key"
